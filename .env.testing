APP_NAME="AI ATS Resume Builder"
APP_ENV=testing
APP_DEBUG=true
APP_URL=http://localhost
# APP_KEY is provided by phpunit.xml (do not blank it here).

# Isolated test database only. Never point this at database/database.sqlite
# or any development/production MySQL schema.
DB_CONNECTION=sqlite
DB_DATABASE=:memory:

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array

AI_PROVIDER=null
XAI_API_KEY=
XAI_MODEL=
XAI_BASE_URL=https://api.x.ai/v1
XAI_TIMEOUT=5
XAI_MAX_RETRIES=0
