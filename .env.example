APP_NAME="AI ATS Resume Builder"
APP_ENV=local
APP_KEY=
# Set APP_DEBUG=false and APP_ENV=production before any public deployment.
# On Render: APP_ENV=production, APP_DEBUG=false, APP_URL=https://<service>.onrender.com
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# On Render, prefer: LOG_CHANNEL=stderr and LOG_LEVEL=error

# Prefer a dedicated MySQL database for this app.
# Render Blueprint expects an EXTERNAL MySQL host (not PostgreSQL).
# Do not point this at production or shared existing DBs without review.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ai_ats_resume_builder
DB_USERNAME=root
DB_PASSWORD=

# Local scaffolding fallback (comment MySQL above and uncomment to use SQLite):
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite
#
# PHPUnit forces sqlite :memory: via phpunit.xml / .env.testing.
# Never run RefreshDatabase / migrate:fresh against this app database.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Resume uploads use the local disk (storage/app/private). On Render, mount a
# persistent disk at /var/www/html/storage — the container filesystem is ephemeral.
FILESYSTEM_DISK=local
# Production on Render: QUEUE_CONNECTION=sync (no ShouldQueue jobs today).
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# AI providers (server-side only — never expose to VITE_*)
# Resume import defaults to Gemini. Other tasks use AI_PROVIDER until overridden.
# Important: quote "null" — unquoted null becomes empty and breaks the AI driver.
# ---------------------------------------------------------------------------
AI_PROVIDER="null"
AI_RESUME_IMPORT_PROVIDER=gemini

# Google Gemini (resume extraction)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=90
GEMINI_MAX_RETRIES=1

# xAI Grok (optional — JD analysis / resume drafting)
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=
XAI_TIMEOUT=45
XAI_MAX_RETRIES=1
AI_JD_RATE_LIMIT=5

# Bootstrap admin when no users exist (php artisan db:seed).
# Production seeding refuses the default password below — set a strong ADMIN_PASSWORD.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=password
SESSION_SECURE_COOKIE=
SESSION_SAME_SITE=lax
