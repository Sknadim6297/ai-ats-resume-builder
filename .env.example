APP_NAME="AI ATS Resume Builder"
APP_ENV=local
APP_KEY=
# Set APP_DEBUG=false and APP_ENV=production before any public deployment.
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Prefer a dedicated MySQL database for this app.
# Do not point this at production or shared existing DBs without review.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ai_ats_resume_builder
DB_USERNAME=root
DB_PASSWORD=

# Local scaffolding fallback (comment MySQL above and uncomment to use SQLite):
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite
#
# PHPUnit forces sqlite :memory: via phpunit.xml / .env.testing.
# Never run RefreshDatabase / migrate:fresh against this app database.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# AI / xAI Grok (server-side only — never expose to VITE_*)
# Keep AI_PROVIDER=null until you configure a key and model from current xAI docs.
# Example model from xAI docs: grok-4.7
# ---------------------------------------------------------------------------
AI_PROVIDER=null
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=
XAI_TIMEOUT=45
XAI_MAX_RETRIES=1
AI_JD_RATE_LIMIT=5

# Bootstrap admin when no users exist (php artisan db:seed).
# Production seeding refuses the default password below — set a strong ADMIN_PASSWORD.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=password
SESSION_SECURE_COOKIE=
SESSION_SAME_SITE=lax
